# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=

# Google Gemini API Configuration
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# SQLite Database Location
DATABASE_PATH=data/emma_bot.db

# Web App Port
PORT=8000

# Rate Limiting
RATE_LIMIT_COUNT=15
RATE_LIMIT_WINDOW_SECONDS=60
CHAT_HISTORY_LIMIT=20

